{
  "name": "@paycontrollimited/cashier",
  "version": "1.7.0",
  "license": "SEE LICENSE IN LICENCE.md",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.css",
    "dist/index.d.ts",
    "dist/server.d.ts",
    "dist/types/CashierConfig.d.ts",
    "dist/types/presentation.d.ts",
    "styles.d.ts",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENCE.md",
    "dist/utils/purchaseValidation.d.ts",
    "dist/purchase.d.ts",
    "dist/types/offers.d.ts"
  ],
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PayControlLimited/cashier-public.git"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/server.js",
      "browser": "./dist/index.js",
      "node": "./dist/server.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "style": "./dist/index.css",
      "import": "./dist/index.css",
      "require": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./purchase": {
      "types": "./dist/purchase.d.ts",
      "import": "./dist/purchase.js",
      "default": "./dist/purchase.js"
    }
  },
  "nx": {
    "tags": [
      "publishable"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
